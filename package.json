{
  "name": "bullpen",
  "version": "0.1.21",
  "description": "Local multi-agent harness for Claude Code",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:cold": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --import ./test/raw-loader.mjs --test test/*.test.ts",
    "verify:hook": "node --experimental-strip-types scripts/verify-hook.ts",
    "postinstall": "node scripts/patch-node-pty.mjs && electron-rebuild -f -w node-pty",
    "build:mac": "npm run rebuild:sparkle && electron-vite build && electron-builder --config electron-builder.config.mjs --mac",
    "build:win": "electron-vite build && electron-builder --config electron-builder.config.mjs --win",
    "release": "npm run rebuild:sparkle && electron-vite build && electron-builder --config electron-builder.config.mjs --mac --win -p always",
    "rebuild:sparkle": "CC=/usr/bin/clang CXX=/usr/bin/clang++ electron-sparkle-updater rebuild --arch universal"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vim": "^6.4.0",
    "codemirror": "^6.0.2",
    "electron-sparkle-updater": "^0.2.0",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
    "zustand": "^5.0.0"
  }
}
